{
  "name": "@rydr/game-__SLUG__",
  "version": "0.0.0",
  "description": "__TITLE__ — a RYDR platform game.",
  "type": "module",
  "rydr": {
    "slug": "__SLUG__",
    "title": "__TITLE__",
    "icon": "gamepad",
    "accent": "#4a73c0",
    "boards": []
  },
  "scripts": {
    "dev": "concurrently -k -n game,shell \"vite\" \"npx -y --package github:bdefrenne/rydr-platform rydr-dev-shell --slug __SLUG__ --title \\\"__TITLE__\\\" --game http://localhost:3400\"",
    "update": "npm install $(node -p \"[...Object.keys(require('./package.json').dependencies||{}),...Object.keys(require('./package.json').devDependencies||{})].filter(d=>d.startsWith('@rydr/')).map(d=>d+'@latest').join(' ')\")",
    "build": "tsc && vite build",
    "typecheck": "tsc -p tsconfig.json",
    "preview": "vite preview",
    "deploy:link": "vercel link --yes --project rydr-game-__SLUG__",
    "deploy": "vercel --prod --yes"
  },
  "dependencies": {
    "@rydr/game-sdk": "^3.5.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
